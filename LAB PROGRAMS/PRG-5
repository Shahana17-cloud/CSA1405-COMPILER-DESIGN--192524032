#include <stdio.h>

int main()
{
    char str[100];
    int words = 0;
    int lines = 0;
    int characters = 0;
    int i;

    printf("Enter text (use ~ to end):\n");

    scanf("%[^~]", str);

    for (i = 0; str[i] != '\0'; i++)
    {
        if (str[i] == ' ' || str[i] == '\t')
        {
            words++;
        }
        else if (str[i] == '\n')
        {
            lines++;
        }
        else
        {
            characters++;
        }
    }

    if (characters > 0)
    {
        words++;
        lines++;
    }

    printf("Total number of words: %d\n", words);
    printf("Total number of lines: %d\n", lines);
    printf("Total number of characters: %d\n", characters);

    return 0;
}
