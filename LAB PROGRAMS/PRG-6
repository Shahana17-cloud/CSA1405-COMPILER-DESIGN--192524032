#include <stdio.h>
#include <ctype.h>

int main()
{
    char a[50];
    int flag = 1;
    int i = 1;

    printf("Enter an identifier: ");
    scanf("%49s", a);

    if (isalpha(a[0]))
    {
        while (a[i] != '\0')
        {
            if (!isdigit(a[i]) && !isalpha(a[i]))
            {
                flag = 0;
                break;
            }

            i++;
        }
    }
    else
    {
        flag = 0;
    }

    if (flag == 1)
    {
        printf("Valid identifier\n");
    }
    else
    {
        printf("Not a valid identifier\n");
    }

    return 0;
}
